  "attributes": {
    "AC Bonus": {
      "desc": "This weapon grants a bonus to your AC while it is equipped.",
      "tooltip": "This weapon grants {X} to your AC while it is equipped."
    },
    "Ambush": {
      "desc": "This weapon always crits when attacking a Surprised target."
    },
    "Bayonet": {
      "desc": "You may attach a dagger to the front of this weapon, allowing it to be used in melee with the stats of a longspear."
    },
    "Bulky": {
      "desc": "This weapon must be braced using a Bonus Action in order to attack with it. Once braced, you remain braced until you move."
    },
    "Complex": {
      "desc": "This weapon requires three Attacks to reload."
    },
    "Concealed": {
      "desc": "This weapon grants a bonus to any Check made to conceal it.",
      "tooltip": "This weapon grants {X} to any Check made to conceal it."
    },
    "Conductive": {
      "desc": "Energy currents, such as electricity or the Ripple, may run through this weapon without harming the weilder."
    },
    "Firearm": {
      "desc": "This weapon makes a loud sound which can be heard up to 0.5km away. It also jams if a Natural 1 is rolled while using it, requiring an Attack to un-jam the weapon before it may be fired again. This weapon's ammunition doesn't function when wet."
    },
    "Fist": {
      "desc": "If you would deal more damage with your Unarmed Strikes than with this weapon, you may instead use the damage from your Unarmed Strikes."
    },
    "Flame": {
      "desc": "When a flammable object not being worn or carried takes Fire damage from this weapon, it is set ablaze, allowing the fire to spread further from there."
    },
    "Hunker": {
      "desc": "While holding this item, if you've not moved this Turn, you may reduce your Movement Speed to 0 and gain Cover in one direction as a Bonus Action until the start of your next Turn.",
      "tooltip": "While holding this item, if you've not moved this Turn, you may reduce your Movement Speed to 0 and gain {X} Cover in one direction as a Bonus Action until the start of your next Turn."
    },
    "Light": {
      "desc": "This weapon is light and easy to handle, allowing you to make an additional Attack using another Light weapon in your other hand as a Bonus Action."
    },
    "Limited Hand": {
      "desc": "When you have this weapon equipped, you may also use other Light weapons, tiny objects, or Shove and Grapple as though your hand was free. This weapon's attributes and damage do not apply at the same time as another in the same hand."
    },
    "Open Hand": {
      "desc": "When you have this weapon equipped, you may also use other weapons, objects, or Shove and Grapple as though your hand was free. This weapon's attributes and damage do not apply at the same time as another in the same hand."
    },
    "Point Blank": {
      "desc": "This weapon does not impose Disadvantage if used within melee."
    },
    "Radius": {
      "desc": "This weapon forces all creatures within a certain radius of the target to make a Dexterity Saving Throw, taking half damage on success and full damage on failure. This projectile or charge is destroyed after use.",
      "tooltip": "This weapon forces all creatures within {X} of the target to make a Dexterity Saving Throw, taking half damage on success and full damage on failure. This projectile or charge is destroyed after use."
    },
    "Ranged": {
      "desc": "This weapon can hit targets up to its Short Range, or as far as its Long Range with Disadvantage. Attacking within melee imposes Disadvantage.",
      "tooltip": "This weapon can hit targets up to {X}m away, or as far as {Y}m with Disadvantage. Attacking within melee imposes Disadvantage."
    },
    "Reach": {
      "desc": "This weapon can hit targets from an additional meter away."
    },
    "Reliable": {
      "desc": "This weapon does not jam."
    },
    "Reload": {
      "desc": "This weapon can be used a limited amount of times before needing to be reloaded. Reloading uses an Attack.",
      "tooltip": "This weapon can be used {X} times before needing to be reloaded. Reloading uses an Attack."
    },
    "Remote": {
      "desc": "This weapon can be triggered as a Bonus Action from up to 1km away."
    },
    "Return": {
      "desc": "After throwing this weapopn, you may use your Reaction to catch it, putting it back in your inventory."
    },
    "Siege": {
      "desc": "This weapon deals double damage to objects."
    },
    "Timer": {
      "desc": "A timer may be set on this weapon, triggering it once the timer runs out. The timer may be set for up to 12 hours."
    },
    "Throwable": {
      "desc": "This weapon can be thrown up to its Short Range, or as far as its Long Range with Disadvantage. Once thrown, this weapon must be picked up in order to be used again (unless it is an Explosive, in which case it is destroyed).",
      "tooltip": "This weapon can be thrown up to {X}m away, or as far as {Y}m with Disadvantage. Once thrown, this weapon must be picked up in order to be used again (unless it is an Explosive, in which case it is destroyed)."
    },
    "Two-Handed": {
      "desc": "This weapon requires two hands to wield, and is difficult to holster or conceal. It may be carried (but not used) with one hand if desired."
    },
    "Versatile": {
      "desc": "This weapon may be wielded with one or two hands, dealing more damage if two hands are used.",
      "tooltip": "This weapon may be wielded with one or two hands, dealing {X} damage if two hands are used."
    }
  }
}
